#!/usr/bin/env bash
#
# headset-sco-recover: keep a Bluetooth headset's call-mode microphone alive
# across calls by resetting its hands-free (HFP) link.
#
# Why this exists. After a call, the call link (SCO) can stay alive on the
# Bluetooth controller or headset although the kernel has forgotten it ("SCO
# packet for unknown connection handle"). The next switch to the headset
# profile then fails at once: the SCO connect is refused with EMLINK ("Too
# many links"), the microphone node goes to "error", the call hears nothing,
# and about 16 s later Teams reopens the device and the headset drops.
# Reproduced 2026-11-24: it happens when a playback stream that ran through
# the first call is still playing at the second switch (a ringtone on a
# direct call). The state never clears by itself. Disconnecting and
# reconnecting only the Handsfree profile clears it in 1.2 s while music keeps
# playing over A2DP; the first call after such a reset has never failed.
#
# How. The local WirePlumber override
# (~/.local/share/wireplumber/scripts/device/autoswitch-bluetooth-profile.lua)
# logs two markers, and this script follows the journal for them (WirePlumber's
# Lua sandbox cannot run a command):
#
#   headset-hfp-left card=bluez_card.<MAC>      call mode was left
#     -> prevention: reset the HFP link now, so the next call starts clean.
#        Skipped if the microphone is already in use again.
#   headset-sco-dead node=bluez_input.<MAC>.0   call mode started dead
#     -> repair: reset the HFP link and put the card back in call mode.
#
# Never runs sudo. Touches only bluetoothctl and the card profile of the one
# device named in the log line.

set -euo pipefail

readonly HF_UUID="0000111e-0000-1000-8000-00805f9b34fb"
readonly DEAD_HOLDOFF=8
last_dead=0

notify() {
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send "$1" "$2" -u normal >/dev/null 2>&1 || true
}

# Active profile of the card for MAC $1 (underscore form), empty if absent.
card_profile() {
  pactl list cards 2>/dev/null |
    awk -v n="Name: bluez_card.$1" 'index($0, n) {f=1} f && /Active Profile:/ {print $3; exit}'
}

# True while something records from the headset's microphone source.
mic_in_use() {
  pactl list sources short 2>/dev/null |
    awk -v n="bluez_input.$1" '$2 == n && $NF == "RUNNING" {found=1} END {exit !found}'
}

# Reset the hands-free link of MAC $1 (colon form). A2DP stays up.
reset_hfp() {
  local mac=$1 try
  bluetoothctl disconnect "$mac" "$HF_UUID" >/dev/null 2>&1 || true
  sleep 1
  for try in 1 2 3; do
    if bluetoothctl connect "$mac" "$HF_UUID" 2>&1 | grep -q "Connection successful"; then
      sleep 1.5   # let PipeWire finish the HFP handshake
      return 0
    fi
    sleep 1
  done
  echo "HFP reconnect failed for $mac; reconnecting the whole device" >&2
  bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
  sleep 3
  bluetoothctl connect "$mac" >/dev/null 2>&1 || true
  return 1
}

# If a call holds the microphone but the card is not in call mode, switch it.
ensure_call_mode() {
  local mac=$1 us=${1//:/_} try
  for try in 1 2 3 4 5 6; do
    mic_in_use "$mac" || return 0
    [[ $(card_profile "$us") == headset-head-unit* ]] && return 0
    if pactl set-card-profile "bluez_card.$us" headset-head-unit 2>/dev/null; then
      echo "put $mac back in call mode"
      return 0
    fi
    sleep 0.5
  done
  echo "could not put $mac back in call mode" >&2
}

journalctl --user -u wireplumber -f -n 0 -o cat -g "headset-(hfp-left|sco-dead)" |
  while IFS= read -r line; do
    [[ $line =~ (card=bluez_card|node=bluez_input)\.(([0-9A-F]{2}_){5}[0-9A-F]{2}) ]] || continue
    us=${BASH_REMATCH[2]}
    mac=${us//_/:}

    if [[ $line == *headset-hfp-left* ]]; then
      sleep 1   # let the call link finish closing
      if mic_in_use "$mac" || [[ $(card_profile "$us") == headset-head-unit* ]]; then
        echo "call mode left but the microphone is in use again; not resetting $mac"
        continue
      fi
      if reset_hfp "$mac"; then echo "reset HFP after call on $mac"; fi
      ensure_call_mode "$mac"
    else
      now=$(date +%s)
      (( now - last_dead < DEAD_HOLDOFF )) && continue
      last_dead=$now
      echo "call mode started dead on $mac; resetting HFP"
      notify "Headset microphone was dead" "Resetting the headset link, about 3 s."
      reset_hfp "$mac" || true
      ensure_call_mode "$mac"
    fi
  done
